# ⚠️ IMPORTANT: This file is a TEMPLATE. 
# NEVER commit this file with actual secrets to git or any repository.
# Use this file only locally during development.
# For production, set these variables on your hosting platform's dashboard.

# Django Settings
DJANGO_SECRET_KEY=your-very-long-secret-key-here-generate-a-new-one-for-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database Configuration (PostgreSQL)
POSTGRES_DB=clindocs_db
POSTGRES_USER=clindocs_user
POSTGRES_PASSWORD=secure-password-here-use-strong-random-password
POSTGRES_HOST=your-postgres-host.com
POSTGRES_PORT=5432

# Email Configuration
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=noreply@yourdomain.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password

# Security Settings (for HTTPS enabled sites)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True

# Other Settings
ENVIRONMENT=production
LOG_LEVEL=INFO
